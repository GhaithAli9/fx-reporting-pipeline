# Secrets — never commit real credentials
.env
# Exception: contains no secrets, just AIRFLOW_UID/path/pip-list -- see docs/system-design.md ADR-012
!airflow_docker/.env

# Python virtual environment
venv/
__pycache__/
*.pyc

# Raw landed data (regenerated by extractors, not source)
data/

# Local database files and dbt build artifacts (regenerated, not source)
*.duckdb
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/

# Airflow local metadata / runtime logs (regenerated by docker compose)
dags/logs/
logs/
config/
plugins/

# dbt local machine state (not project source)
dbt_project/.user.yml

# Downloaded tool binaries (not project source)
tools/

# pytest cache
.pytest_cache/
